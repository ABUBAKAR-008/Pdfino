# Copy this file to .env and fill in real values for your environment.
# Never commit your actual .env file to version control.

# Django
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ENV=development

# Database - blank uses local SQLite only when DJANGO_ENV=development.
# Production must use PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/pdfino?sslmode=require
DATABASE_URL=
POSTGRES_SSLMODE=prefer
POSTGRES_CONN_MAX_AGE=60
POSTGRES_CONNECT_TIMEOUT=10

# Uploads / processing
MAX_UPLOAD_SIZE=52428800
MAX_TOTAL_UPLOAD_SIZE=209715200
MAX_UPLOAD_FILES=30
MAX_PDF_PAGES=300
MAX_IMAGE_PIXELS=40000000
MAX_OUTPUT_SIZE=209715200
MAX_OUTPUT_PAGES=500
FILE_RETENTION_MINUTES=60
STAGING_RETENTION_MINUTES=15
DOWNLOAD_TOKEN_MAX_AGE=900
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_ANONYMOUS=10
RATE_LIMIT_AUTHENTICATED=30
RATE_LIMIT_EXPENSIVE=5
PROCESSING_TIMEOUT_SECONDS=120
MAX_CONCURRENT_PROCESSING=2
MAX_CONCURRENT_PER_CLIENT=1
PROCESSING_ACQUIRE_TIMEOUT_SECONDS=0

# Production-only (ignored while DEBUG=True)
SECURE_SSL_REDIRECT=True
HTTPS_ENABLED=True
SECURE_HSTS_PRELOAD=True
CSRF_TRUSTED_ORIGINS=https://www.example.com
