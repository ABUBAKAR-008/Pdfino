# Copy this file to .env and fill in real values for your environment.
# Never commit your actual .env file to version control.

# Django
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Database - leave blank for local SQLite, or set a PostgreSQL URL for production:
# DATABASE_URL=postgres://user:password@host:5432/pdfino
DATABASE_URL=

# Uploads / processing
MAX_UPLOAD_SIZE=52428800
MAX_UPLOAD_FILES=30
FILE_RETENTION_MINUTES=60

# Production-only (ignored while DEBUG=True)
SECURE_SSL_REDIRECT=True
